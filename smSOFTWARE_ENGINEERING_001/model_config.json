{
  "format_version": 1,
  "name": "smSOFTWARE_ENGINEERING_001-micro",
  "architecture": {
    "vocab_size": 256,
    "context_length": 128,
    "width": 192,
    "layers": 4,
    "heads": 6,
    "dropout": 0.1,
    "tie_embeddings": true
  },
  "tokenizer": {
    "kind": "utf8_bytes",
    "vocab_size": 256
  },
  "generation": {
    "temperature": 0.35,
    "top_k": 24,
    "repetition_penalty": 1.08,
    "max_tokens": 160
  },
  "training": {
    "batch_size": 32,
    "steps": 1200,
    "learning_rate": 0.0002,
    "warmup_steps": 60,
    "eval_every": 100,
    "eval_batches": 16,
    "weight_decay": 0.05,
    "school_replay_fraction": 0.25,
    "seed": 15001
  }
}
